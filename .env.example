# CivicSense Environment Configuration
# Copy this file to .env for local overrides

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civicsense

# Application Environment
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Security & CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]
MAX_PAYLOAD_SIZE_BYTES=10485760

# Google Maps (dashboard map features)
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Mobile Client Configuration (read by mobile app in development)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
