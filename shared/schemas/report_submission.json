{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CivicSenseReportSubmission",
  "description": "Canonical contract for citizen report submission from mobile/edge clients to CivicSense API v1",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "location",
    "description"
  ],
  "additionalProperties": false,
  "properties": {
    "client_report_id": {
      "type": "string",
      "description": "Optional client-generated UUID for offline idempotency tracking",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 creation timestamp recorded on device",
      "format": "date-time"
    },
    "location": {
      "type": "object",
      "description": "Geographical coordinates of the observed civic issue",
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90.0,
          "maximum": 90.0
        },
        "longitude": {
          "type": "number",
          "minimum": -180.0,
          "maximum": 180.0
        },
        "accuracy_meters": {
          "type": "number",
          "minimum": 0.0
        },
        "address_hint": {
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "description": {
      "type": "string",
      "description": "Citizen natural-language description of the problem",
      "minLength": 3,
      "maxLength": 5000
    },
    "category": {
      "type": "string",
      "description": "Citizen-selected civic issue category",
      "maxLength": 64
    },
    "evidence": {
      "type": "array",
      "description": "List of evidence items attached to this submission",
      "items": {
        "type": "object",
        "required": [
          "evidence_type",
          "storage_uri"
        ],
        "additionalProperties": false,
        "properties": {
          "evidence_type": {
            "type": "string",
            "enum": [
              "IMAGE",
              "TEXT",
              "METADATA"
            ]
          },
          "storage_uri": {
            "type": "string",
            "description": "URI or relative path referencing the stored evidence asset"
          },
          "file_hash": {
            "type": "string",
            "description": "Cryptographic hash (e.g. SHA-256) of the evidence asset"
          },
          "mime_type": {
            "type": "string",
            "description": "MIME type of the asset (e.g. image/jpeg)"
          },
          "file_size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "metadata_json": {
            "type": "object",
            "description": "Arbitrary structured metadata such as EXIF or camera orientation"
          }
        }
      }
    },
    "edge_metadata": {
      "type": "object",
      "description": "Optional edge processing metadata for future lightweight inference results",
      "additionalProperties": false,
      "properties": {
        "local_prediction": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          }
        },
        "image_quality_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "vision_model_version": {
          "type": "string"
        },
        "text_pipeline_version": {
          "type": "string"
        }
      }
    }
  }
}
